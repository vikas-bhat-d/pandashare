generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")   // Supabase pooler (Transaction mode, port 6543) — used at runtime
  directUrl = env("DIRECT_URL")    // Supabase direct connection (port 5432) — used by prisma migrate
}

model Room {
  id        String   @id @default(cuid())
  name      String   @unique
  mode      RoomMode
  salt      String?  // base64 encoded, null for public rooms
  baseIV    String?  // base64 encoded, null for public rooms
  verifier  String?  // HMAC-SHA256(roomName | password) hex, null for public rooms
  createdAt DateTime @default(now())
  expiresAt DateTime
  files     File[]

  @@index([name])
  @@index([expiresAt])
}

model File {
  id          String   @id @default(cuid())
  roomId      String
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  fileName    String
  totalChunks Int
  size        BigInt   // File size in bytes
  uploadedAt  DateTime @default(now())
  isComplete  Boolean  @default(false)
  isMultipart Boolean  @default(false) // true = stored as single S3 object via multipart upload
  chunkSize   Int      @default(0)     // plaintext chunk size used during encryption (0 = old chunked format)

  @@index([roomId])
}

enum RoomMode {
  password
  public
}

model TextSnippet {
  id        String   @id @default(cuid())
  name      String   @unique
  mode      RoomMode
  content   String   // plaintext (public) or base64 AES-GCM ciphertext (password)
  salt      String?  // base64-encoded, null for public snippets
  baseIV    String?  // base64-encoded, null for public snippets
  verifier  String?  // HMAC-SHA256(name|password) hex, null for public snippets
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([name])
  @@index([expiresAt])
}
